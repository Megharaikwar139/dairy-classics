# ========================================================
# ASSETS DIRECTORY SECURITY - ANTI-WEBSHELL / EXECUTION DENIAL
# ========================================================

# 1. Disable execution of all server-side scripts
Options -Indexes -ExecCGI

# 2. Block direct execution of any script extensions
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|cgi|pl|py|sh|bash|exe|bat|cmd|jsp|asp|aspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Disable PHP engine inside assets if mod_php is active
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
