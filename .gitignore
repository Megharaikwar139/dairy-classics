# ========================================================
# DAIRY CLASSIC - GIT IGNORE & SECURITY EXCLUSIONS
# ========================================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.agents/
.gemini/

# Environment & Credentials
.env
.env.*
*.pem
*.key
*.cert
*.crt

# Database & Backups
*.sql
*.sqlite
*.bak
*.old
*.backup

# Logs and Caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Server temporary files
/tmp/
/temp/
